<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Algospeak Dictionary</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0d0d0d;
    color: #fff;
    font-family: 'Inter', Arial, sans-serif;
    line-height: 1.6;
  }

  /* ===== ШАПКА ===== */
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    position: sticky;
    top: 0;
    background: rgba(13,13,13,0.9);
    backdrop-filter: blur(10px);
    z-index: 100;
    border-bottom: 1px solid #222;
    flex-wrap: wrap;
    gap: 10px;
  }

  .logo {
    font-family: 'Courier New', monospace;
    font-size: 22px;
    color: #39ff14;
    font-weight: bold;
  }
  .logo::after {
    content: '|';
    animation: blink 1s infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  nav a {
    color: #ccc;
    text-decoration: none;
    margin-left: 20px;
    font-size: 14px;
    transition: color 0.3s;
  }
  nav a:hover { color: #39ff14; }

  /* ===== HERO ===== */
  .hero {
    text-align: center;
    padding: 100px 20px 80px;
  }

  .hero h1 {
    font-family: 'Courier New', monospace;
    font-size: 72px;
    color: #39ff14;
    letter-spacing: 4px;
    text-shadow: 0 0 20px rgba(57,255,20,0.5);
    margin-bottom: 25px;
  }

  .changing-word {
    font-size: 24px;
    color: #ff00ff;
    font-family: 'Courier New', monospace;
    height: 40px;
    margin-bottom: 30px;
  }

  .hero p {
    font-size: 18px;
    color: #aaa;
    max-width: 500px;
    margin: 0 auto 40px;
  }

  .btn {
    display: inline-block;
    padding: 15px 40px;
    background: transparent;
    border: 2px solid #39ff14;
    color: #39ff14;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    border-radius: 8px;
  }
  .btn:hover {
    background: #39ff14;
    color: #0d0d0d;
    box-shadow: 0 0 25px rgba(57,255,20,0.6);
  }

  /* ===== СЕКЦИИ ===== */
  section {
    padding: 80px 40px;
    max-width: 1100px;
    margin: 0 auto;
  }

  h2 {
    font-family: 'Courier New', monospace;
    font-size: 36px;
    color: #fff;
    margin-bottom: 40px;
    text-align: center;
  }
  h2 span { color: #39ff14; }

  /* ===== КАРТОЧКИ ТЕОРИИ ===== */
  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }

  .info-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid #222;
    border-radius: 15px;
    padding: 30px;
    transition: all 0.3s;
  }
  .info-card:hover {
    border-color: #39ff14;
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(57,255,20,0.15);
  }
  .info-card .icon { font-size: 40px; margin-bottom: 15px; }
  .info-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
    color: #39ff14;
  }
  .info-card p { color: #bbb; font-size: 15px; }

  /* ===== ТАЙМЛАЙН ===== */
  .timeline-years {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 35px;
  }

  .year-btn {
    padding: 12px 26px;
    background: transparent;
    border: 2px solid #333;
    color: #ccc;
    border-radius: 30px;
    cursor: pointer;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    transition: all 0.3s;
  }
  .year-btn:hover {
    border-color: #39ff14;
    color: #39ff14;
  }
  .year-btn.active {
    border-color: #39ff14;
    background: #39ff14;
    color: #0d0d0d;
    box-shadow: 0 0 20px rgba(57,255,20,0.5);
  }

  .timeline-content {
    background: rgba(255,255,255,0.03);
    border: 1px solid #222;
    border-left: 3px solid #39ff14;
    border-radius: 12px;
    padding: 30px;
    min-height: 120px;
    font-size: 16px;
    color: #ddd;
    transition: all 0.3s;
  }
  .timeline-content .year-label {
    font-family: 'Courier New', monospace;
    font-size: 24px;
    color: #39ff14;
    font-weight: bold;
    margin-bottom: 12px;
  }

  /* ===== ПОИСК И ФИЛЬТРЫ ===== */
  .controls {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 35px;
    align-items: center;
  }

  #searchInput {
    width: 100%;
    max-width: 500px;
    padding: 15px 20px;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 10px;
    color: #fff;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    outline: none;
    transition: border 0.3s;
  }
  #searchInput:focus { border-color: #39ff14; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .filter-btn {
    padding: 8px 18px;
    background: transparent;
    border: 1px solid #444;
    color: #ccc;
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.3s;
  }
  .filter-btn:hover, .filter-btn.active {
    border-color: #39ff14;
    color: #39ff14;
    box-shadow: 0 0 15px rgba(57,255,20,0.3);
  }

  /* ===== СЛОВАРЬ ===== */
  .dictionary {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  .word-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid #222;
    border-radius: 12px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s;
  }
  .word-card:hover {
    border-color: #39ff14;
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(57,255,20,0.25);
  }
  .word-card .word {
    font-family: 'Courier New', monospace;
    font-size: 20px;
    color: #39ff14;
    margin-bottom: 10px;
  }
  .word-card .meaning {
    font-size: 14px;
    color: #ccc;
  }
  .word-card .category {
    font-size: 11px;
    color: #ff00ff;
    text-transform: uppercase;
    margin-top: 10px;
    letter-spacing: 1px;
  }

  /* ===== ВИКТОРИНА ===== */
  .quiz-box {
    background: rgba(255,255,255,0.03);
    border: 1px solid #222;
    border-radius: 15px;
    padding: 40px 30px;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .quiz-question {
    font-size: 20px;
    color: #fff;
    margin-bottom: 25px;
    font-family: 'Courier New', monospace;
    min-height: 60px;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .quiz-option {
    padding: 15px 20px;
    background: #1a1a1a;
    border: 2px solid #333;
    border-radius: 10px;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s;
    text-align: left;
    font-family: inherit;
  }
  .quiz-option:hover:not(.disabled) {
    border-color: #39ff14;
    transform: translateX(5px);
  }
  .quiz-option.correct {
    border-color: #39ff14;
    background: rgba(57,255,20,0.15);
    color: #39ff14;
  }
  .quiz-option.wrong {
    border-color: #ff0044;
    background: rgba(255,0,68,0.15);
    color: #ff5555;
  }
  .quiz-option.disabled { cursor: not-allowed; }

  .quiz-feedback {
    font-size: 15px;
    color: #aaa;
    margin: 15px 0;
    min-height: 40px;
    font-style: italic;
  }

  .quiz-progress {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    color: #666;
    margin-bottom: 20px;
  }

  .quiz-result {
    font-family: 'Courier New', monospace;
    font-size: 26px;
    color: #ff00ff;
    margin: 20px 0;
    text-shadow: 0 0 15px rgba(255,0,255,0.4);
  }

  /* ===== ГЕНЕРАТОР ===== */
  .generator {
    text-align: center;
  }

  .gen-input {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }

  .gen-input input {
    padding: 15px 20px;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 10px;
    color: #fff;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    outline: none;
    width: 280px;
  }
  .gen-input input:focus { border-color: #39ff14; }

  #genResult {
    font-family: 'Courier New', monospace;
    font-size: 32px;
    color: #ff00ff;
    min-height: 50px;
    text-shadow: 0 0 15px rgba(255,0,255,0.5);
  }

  /* ===== ПОДВАЛ ===== */
  footer {
    text-align: center;
    padding: 40px 20px;
    border-top: 1px solid #222;
    color: #666;
    font-size: 14px;
  }

  /* ===== МОБИЛЬНАЯ ВЕРСИЯ ===== */
  @media (max-width: 768px) {
    header { padding: 15px 20px; }
    nav a { margin-left: 12px; font-size: 12px; }
    .hero { padding: 70px 20px 50px; }
    .hero h1 { font-size: 42px; }
    .changing-word { font-size: 18px; }
    section { padding: 50px 20px; }
    h2 { font-size: 26px; }
    .quiz-box { padding: 25px 20px; }
    .quiz-question { font-size: 17px; }
  }
</style>
</head>
<body>

<!-- ШАПКА -->
<header>
  <div class="logo">algospeak</div>
  <nav>
    <a href="#timeline">История</a>
    <a href="#dictionary">Словарь</a>
    <a href="#quiz">Викторина</a>
    <a href="#generator">Генератор</a>
  </nav>
</header>

<!-- HERO -->
<div class="hero">
  <h1>ALGOSPEAK</h1>
  <div class="changing-word" id="changingWord">shadow realm</div>
  <p>Тайный язык социальных сетей для обхода алгоритмов модерации</p>
  <a href="#timeline" class="btn">Узнать больше</a>
</div>

<!-- ЧТО ЭТО -->
<section>
  <h2>Что такое <span>алгоспик</span>?</h2>
  <div class="info-cards">
    <div class="info-card">
      <div class="icon">🧠</div>
      <h3>Что это</h3>
      <p>Набор кодовых слов и эвфемизмов, которые пользователи придумывают для обхода фильтров.</p>
    </div>
    <div class="info-card">
      <div class="icon">⚙️</div>
      <h3>Зачем</h3>
      <p>Чтобы контент не удаляли, не блокировали аккаунт и не отправляли в теневой бан.</p>
    </div>
    <div class="info-card">
      <div class="icon">🌍</div>
      <h3>Где</h3>
      <p>TikTok, Instagram, YouTube, Twitch и другие платформы с автоматической модерацией.</p>
    </div>
  </div>
</section>

<!-- ИНТЕРАКТИВ 1: ТАЙМЛАЙН -->
<section id="timeline">
  <h2>История <span>алгоспика</span></h2>
  <div class="timeline-years" id="yearButtons"></div>
  <div class="timeline-content" id="timelineContent">
    <div class="year-label">👆 Выбери год выше</div>
    <p>Нажимай на кнопки с годами, чтобы узнать, что происходило с алгоспиком в этот период.</p>
  </div>
</section>

<!-- СЛОВАРЬ -->
<section id="dictionary">
  <h2>Сло<span>варь</span></h2>

  <div class="controls">
    <input type="text" id="searchInput" placeholder="🔍 Поиск слова...">
    <div class="filters">
      <button class="filter-btn active" data-cat="all">Все</button>
      <button class="filter-btn" data-cat="media">Соцсети</button>
      <button class="filter-btn" data-cat="school">Школа</button>
      <button class="filter-btn" data-cat="looks">Внешность</button>
      <button class="filter-btn" data-cat="emotions">Эмоции</button>
      <button class="filter-btn" data-cat="money">Деньги</button>
    </div>
  </div>

  <div class="dictionary" id="dictionaryGrid"></div>
</section>

<!-- ИНТЕРАКТИВ 2: ВИКТОРИНА -->
<section id="quiz">
  <h2>Викторина: <span>проверь себя</span></h2>
  <div class="quiz-box">
    <div class="quiz-progress" id="quizProgress"></div>
    <div class="quiz-question" id="quizQuestion"></div>
    <div class="quiz-options" id="quizOptions"></div>
    <div class="quiz-feedback" id="quizFeedback"></div>
    <div class="quiz-result" id="quizResult"></div>
  </div>
</section>

<!-- ИНТЕРАКТИВ 3: ГЕНЕРАТОР -->
<section id="generator">
  <h2>Создай свой <span>эвфемизм</span></h2>
  <div class="generator">
    <div class="gen-input">
      <input type="text" id="genInput" placeholder="Введи слово...">
      <button class="btn" onclick="generateWord()">Зашифровать</button>
    </div>
    <div id="genResult"></div>
  </div>
</section>

<!-- О ПРОЕКТЕ -->
<section id="about">
  <h2>О <span>проекте</span></h2>
  <p style="text-align:center; color:#bbb; max-width:700px; margin:0 auto;">
    Индивидуальный проект по английскому языку, 11 класс.<br>
    Тема: алгоспик как лингвистический феномен социальных сетей.
  </p>
</section>

<!-- ПОДВАЛ -->
<footer>
  © 2025 Algospeak Project · Made by Ariya
</footer>

<script>
// ============================================
// 📅 ТАЙМЛАЙН
// ============================================
const timelineData = [
  { 
    year: "2018", 
    title: "Термин «Voldemorting»",
    text: "Лингвист Эмили ван дер Нагель ввела понятие «Voldemorting» — практику неупоминания слов, чтобы не привлекать внимание алгоритмов. Это был фундамент будущего алгоспика."
  },
  { 
    year: "2020", 
    title: "Появление слова «algospeak»",
    text: "Сам термин «algospeak» начал появляться в интернете. Пользователи заметили, что соцсети всё чаще блокируют посты из-за «опасных» слов, и стали придумывать замены."
  },
  { 
    year: "2021", 
    title: "Массовое использование на TikTok",
    text: "TikTok начал жёстко модерировать контент. Блогеры массово перешли на кодовые слова: «unalive» вместо «dead», «seggs» вместо «sex». Алгоспик стал реальностью для миллионов."
  },
  { 
    year: "2022", 
    title: "Статья в Washington Post",
    text: "Крупное издание Washington Post написало статью про алгоспик, и термин стал известен широкой публике. С этого момента о нём заговорили лингвисты и журналисты."
  },
  { 
    year: "2023", 
    title: "Академические исследования",
    text: "Учёные начали серьёзно изучать алгоспик. Появились первые научные работы, которые описали его как «гонку вооружений» между пользователями и алгоритмами."
  },
  { 
    year: "2024+", 
    title: "Часть интернет-культуры",
    text: "Сегодня алгоспик — не просто способ обойти бан, а часть культуры общения. Слова вроде «delulu», «mid», «snatched» используют даже те, кто не задумывается об алгоритмах."
  }
];

const yearButtons = document.getElementById('yearButtons');
const timelineContent = document.getElementById('timelineContent');

timelineData.forEach((item, index) => {
  const btn = document.createElement('button');
  btn.className = 'year-btn';
  btn.textContent = item.year;
  btn.onclick = () => showTimeline(index);
  yearButtons.appendChild(btn);
});

function showTimeline(index) {
  const item = timelineData[index];
  timelineContent.innerHTML = `
    <div class="year-label">${item.year} · ${item.title}</div>
    <p>${item.text}</p>
  `;
  document.querySelectorAll('.year-btn').forEach((b, i) => {
    b.classList.toggle('active', i === index);
  });
}

// ============================================
// 📖 СЛОВАРЬ
// ============================================
const words = [
  { word: "shadow realm", meaning: "теневой бан / блокировка", category: "media" },
  { word: "the clock app", meaning: "TikTok", category: "media" },
  { word: "link in b", meaning: "ссылка в профиле", category: "media" },
  { word: "blowing up", meaning: "стать вирусным", category: "media" },
  { word: "the bird app", meaning: "Twitter / X", category: "media" },
  
  { word: "prison", meaning: "школа", category: "school" },
  { word: "zookeeper", meaning: "учитель", category: "school" },
  { word: "torture", meaning: "домашнее задание", category: "school" },
  { word: "brain melter", meaning: "экзамен", category: "school" },
  { word: "horizontal time", meaning: "сон", category: "school" },
  
  { word: "snatched", meaning: "отлично выглядит", category: "looks" },
  { word: "mid", meaning: "средне, так себе", category: "looks" },
  { word: "drip", meaning: "стильная одежда", category: "looks" },
  { word: "glow up", meaning: "похорошеть со временем", category: "looks" },
  { word: "aesthetic", meaning: "уникальный стиль", category: "looks" },
  
  { word: "salty", meaning: "злится, обижен", category: "emotions" },
  { word: "bummed", meaning: "грустный", category: "emotions" },
  { word: "vibing", meaning: "хорошее настроение", category: "emotions" },
  { word: "snooze fest", meaning: "очень скучно", category: "emotions" },
  { word: "hyped", meaning: "воодушевлён, в предвкушении", category: "emotions" },
  
  { word: "bag", meaning: "деньги", category: "money" },
  { word: "moolah", meaning: "деньги", category: "money" },
  { word: "grub", meaning: "еда", category: "money" },
  { word: "munchies", meaning: "снеки, перекус", category: "money" },
  { word: "liquid gold", meaning: "кофе / энергетик", category: "money" }
];

const grid = document.getElementById('dictionaryGrid');

function renderWords(list) {
  grid.innerHTML = list.map(w => `
    <div class="word-card">
      <div class="word">${w.word}</div>
      <div class="meaning">${w.meaning}</div>
      <div class="category">${w.category}</div>
    </div>
  `).join('');
}

renderWords(words);

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat;
    const filtered = cat === 'all' ? words : words.filter(w => w.category === cat);
    renderWords(filtered);
  });
});

document.getElementById('searchInput').addEventListener('input', (e) => {
  const q = e.target.value.toLowerCase();
  const filtered = words.filter(w => 
    w.word.toLowerCase().includes(q) || w.meaning.toLowerCase().includes(q)
  );
  renderWords(filtered);
});

// ============================================
// 🧠 ВИКТОРИНА
// ============================================
const quizData = [
  {
    question: "Что такое «алгоспик»?",
    options: [
      "Новый музыкальный жанр",
      "Кодовые слова для обхода алгоритмов",
      "Название соцсети",
      "Способ программирования"
    ],
    correct: 1,
    explanation: "Алгоспик — это набор эвфемизмов и кодовых слов для обхода фильтров."
  },
  {
    question: "Почему блогеры используют алгоспик?",
    options: [
      "Чтобы звучать умнее",
      "Чтобы видео не удалили и оно попало в рекомендации",
      "Чтобы скрыть свой возраст",
      "Просто ради шутки"
    ],
    correct: 1,
    explanation: "Главная цель — сохранить контент и не потерять охваты."
  },
  {
    question: "Что означает слово «shadow realm»?",
    options: [
      "Тёмный лес",
      "Теневой бан / блокировка",
      "Ночной режим",
      "Хакерская атака"
    ],
    correct: 1,
    explanation: "Shadow realm — ироничное обозначение теневого бана."
  },
  {
    question: "Какое слово заменяет «школу»?",
    options: [
      "Prison",
      "Zoo",
      "Office",
      "Park"
    ],
    correct: 0,
    explanation: "Школьники в шутку называют школу «prison» (тюрьма)."
  },
  {
    question: "Что означает «snatched»?",
    options: [
      "Украденный",
      "Отлично выглядит",
      "Голодный",
      "Уставший"
    ],
    correct: 1,
    explanation: "Snatched — комплимент внешности, «выглядит потрясающе»."
  }
];

let currentQuestion = 0;
let score = 0;
let answered = false;

const quizQuestion = document.getElementById('quizQuestion');
const quizOptions = document.getElementById('quizOptions');
const quizFeedback = document.getElementById('quizFeedback');
const quizProgress = document.getElementById('quizProgress');
const quizResult = document.getElementById('quizResult');

function loadQuestion() {
  answered = false;
  const q = quizData[currentQuestion];
  quizProgress.textContent = `Вопрос ${currentQuestion + 1} из ${quizData.length}`;
  quizQuestion.textContent = q.question;
  quizOptions.innerHTML = '';
  quizFeedback.textContent = '';
  quizResult.textContent = '';

  q.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'quiz-option';
    btn.textContent = opt;
    btn.onclick = () => checkAnswer(i, btn);
    quizOptions.appendChild(btn);
  });
}

function checkAnswer(index, btn) {
  if (answered) return;
  answered = true;
  
  const q = quizData[currentQuestion];
  const allOptions = document.querySelectorAll('.quiz-option');
  
  allOptions.forEach(o => o.classList.add('disabled'));

  if (index === q.correct) {
    btn.classList.add('correct');
    score++;
    quizFeedback.textContent = "✅ Верно! " + q.explanation;
  } else {
    btn.classList.add('wrong');
    allOptions[q.correct].classList.add('correct');
    quizFeedback.textContent = "❌ Неверно. " + q.explanation;
  }

  setTimeout(() => {
    currentQuestion++;
    if (currentQuestion < quizData.length) {
      loadQuestion();
    } else {
      showResult();
    }
  }, 2200);
}

function showResult() {
  quizProgress.textContent = '';
  quizQuestion.textContent = "Викторина завершена!";
  quizOptions.innerHTML = '';
  quizFeedback.textContent = '';
  quizResult.textContent = `Твой результат: ${score} из ${quizData.length}`;

  const restart = document.createElement('button');
  restart.className = 'btn';
  restart.textContent = 'Пройти заново';
  restart.style.marginTop = '20px';
  restart.onclick = () => {
    currentQuestion = 0;
    score = 0;
    loadQuestion();
  };
  quizOptions.appendChild(restart);
}

loadQuestion();

