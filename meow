// 🎬 АНИМАЦИЯ СЛОВ В HERO
// ============================================
const heroWords = ["shadow realm", "the clock app", "prison", "snatched", "salty", "bag"];
let heroIndex = 0;
setInterval(() => {
  heroIndex = (heroIndex + 1) % heroWords.length;
  document.getElementById('changingWord').textContent = heroWords[heroIndex];
}, 2000);

// ============================================
// 🔐 ГЕНЕРАТОР ЭВФЕМИЗМОВ
// ============================================
function generateWord() {
  const input = document.getElementById('genInput').value.trim().toLowerCase();
  const result = document.getElementById('genResult');
  
  if (!input) {
    result.textContent = "Введи слово!";
    return;
  }

  let encrypted = input
    .replace(/o/g, '0')
    .replace(/о/g, '0')
    .replace(/i/g, '1')
    .replace(/и/g, '1')
    .replace(/e/g, '3')
    .replace(/е/g, '3')
    .replace(/a/g, '4')
    .replace(/а/g, '4')
    .replace(/s/g, '$')
    .replace(/с/g, '$');

  if (input.length <= 4) {
    encrypted = encrypted + "y";
  }

  result.textContent = encrypted;
}
</script>

